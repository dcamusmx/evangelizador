# Copiar este archivo como ".env" en la raíz del proyecto y completar los valores.
# El archivo ".env" ya está en .gitignore, no se sube al repositorio.

# --- Supabase (obligatorio) ---
# Usadas en el cliente (build-time, prefijo VITE_ requerido por Vite)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_SUPABASE_PUBLISHABLE_KEY

# Usadas en el servidor (SSR / rutas /api). Normalmente los mismos valores que arriba, sin prefijo.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_SUPABASE_PUBLISHABLE_KEY
# Solo para operaciones admin del servidor (nunca exponer al cliente)
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY

# --- Cifrado de credenciales guardadas en BD (obligatorio si se usa el panel Credenciales) ---
CREDENCIALES_ENC_KEY=REPLACE_WITH_RANDOM_SERVER_ENCRYPTION_KEY

# --- n8n (opcional, solo si se usan los webhooks) ---
N8N_INTERNAL_API_KEY=REPLACE_WITH_RANDOM_N8N_INTERNAL_API_KEY
N8N_WEBHOOK_GENERAR_MES=
N8N_WEBHOOK_PUBLICAR_MANUAL=


# --- Cloudflare R2 (opcional, solo si no se configuran desde el panel Credenciales) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=

# --- pCloud (opcional, solo si no se configuran desde el panel Credenciales) ---
PCLOUD_AUTH_TOKEN=
PCLOUD_API_HOST=
PCLOUD_CARPETA=
